    {
      "name": "5. Menus & Permissions API",
      "item": [
        {
          "name": "5.1. Get Menus for User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
