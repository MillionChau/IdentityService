        {
          "name": "2.6. Verify Login with New Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK (Login with New Password)\", function () {",
                  "    pm.response.to.have.status(200);",
