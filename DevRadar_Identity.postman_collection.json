  "item": [
    {
      "name": "1. System & Health Check",
      "item": [
        {
          "name": "1.1. Health Check Endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Health status is Healthy\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"Healthy\");",
                  "    pm.expect(jsonData.service).to.eql(\"IdentityService\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication Flow (Chained Workflow)",
      "item": [
        {
          "name": "2.1. Register New User (Tự sinh dữ liệu ngẫu nhiên)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Tự động tạo timestamp ngẫu nhiên để không bị trùng tài khoản giữa các lần chạy",
                  "const randomId = Date.now().toString().slice(-6);",
                  "const userName = 'tester_' + randomId;",
                  "const email = 'tester_' + randomId + '@devradar.local';",
                  "",
                  "pm.collectionVariables.set('testUserName', userName);",
                  "pm.collectionVariables.set('testEmail', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK (Register Success)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response model indicates success\", function () {",
                  "    pm.expect(jsonData.isSuccess).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('user');",
                  "    pm.expect(jsonData.data).to.have.property('tokens');",
                  "});",
                  "",
                  "// Trích xuất UserId, AccessToken và RefreshToken để chuyển tiếp cho các request sau",
                  "if (jsonData.isSuccess && jsonData.data) {",
                  "    pm.collectionVariables.set('userId', jsonData.data.user.id);",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.tokens.refreshToken);",
                  "    console.log('User registered with ID: ' + jsonData.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{testUserName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{initialPassword}}\",\n  \"firstName\": \"Auto\",\n  \"lastName\": \"Tester\",\n  \"phoneNumber\": \"0987654321\",\n  \"address\": \"Ha Noi, Viet Nam\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "2.2. Login with Registered Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK (Login Success)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Tokens are returned on login\", function () {",
                  "    pm.expect(jsonData.isSuccess).to.be.true;",
                  "    pm.expect(jsonData.data.tokens.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.data.tokens.refreshToken).to.be.a('string');",
                  "});",
                  "",
                  "// Cập nhật lại token mới nhất",
                  "pm.collectionVariables.set('accessToken', jsonData.data.tokens.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.data.tokens.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userNameOrEmail\": \"{{testUserName}}\",\n  \"password\": \"{{initialPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "2.3. Get Current User Profile (/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Profile matches registered user\", function () {",
                  "    pm.expect(jsonData.isSuccess).to.be.true;",
                  "    pm.expect(jsonData.data.userName).to.eql(pm.collectionVariables.get('testUserName'));",
                  "    pm.expect(jsonData.data.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "2.4. Refresh JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK (Token Refreshed)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"New access and refresh tokens returned\", function () {",
                  "    pm.expect(jsonData.isSuccess).to.be.true;",
                  "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
                  "    pm.expect(jsonData.data.refreshToken).to.be.a('string');",
                  "});",
                  "",
                  "// Lưu token mới làm phiên hoạt động tiếp theo",
                  "pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{accessToken}}\",\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh-token"
              ]
            }
          }
        },
