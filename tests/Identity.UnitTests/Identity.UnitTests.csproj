      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Identity.API\Identity.API.csproj" />
    <ProjectReference Include="..\..\src\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="..\..\src\Identity.Domain\Identity.Domain.csproj" />
    <ProjectReference Include="..\..\src\Identity.Infrastructure\Identity.Infrastructure.csproj" />
